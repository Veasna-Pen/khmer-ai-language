{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Veasna-Pen/khmer-ai-language/main/schemas/translation.schema.json",
  "title": "KhmerTranslationExample",
  "description": "Schema for reviewed parallel translation examples.",
  "type": "object",
  "required": [
    "id",
    "source",
    "sourceLanguage",
    "targetLanguage",
    "translation",
    "domain",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "sourceLanguage": {
      "type": "string",
      "default": "en"
    },
    "targetLanguage": {
      "type": "string",
      "default": "km"
    },
    "translation": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "software",
        "technology",
        "business",
        "finance",
        "ecommerce",
        "general",
        "legal",
        "healthcare",
        "education"
      ]
    },
    "context": {
      "type": "string"
    },
    "keyTerms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "community-reviewed",
        "expert-reviewed",
        "verified",
        "deprecated"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "description": "Optional citation, e.g. where the source sentence or translation was published."
        },
        "reviewedBy": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "GitHub handles of the reviewers of this example. Every handle must be listed in data/reviewers.json."
        },
        "lastUpdated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date of the last real change or review, YYYY-MM-DD."
        }
      }
    }
  },
  "allOf": [
    {
      "description": "Community review needs at least 2 named reviewers.",
      "if": {
        "required": ["status"],
        "properties": { "status": { "enum": ["community-reviewed"] } }
      },
      "then": {
        "required": ["provenance"],
        "properties": {
          "provenance": {
            "required": ["reviewedBy"],
            "properties": { "reviewedBy": { "minItems": 2 } }
          }
        }
      }
    },
    {
      "description": "Expert-reviewed and verified examples need at least one reviewer who is an expert for the example's domain in data/reviewers.json.",
      "if": {
        "required": ["status"],
        "properties": { "status": { "enum": ["expert-reviewed", "verified"] } }
      },
      "then": {
        "required": ["provenance"],
        "properties": {
          "provenance": {
            "x-requiresReviewerLevel": "expert",
            "required": ["reviewedBy"],
            "properties": { "reviewedBy": { "minItems": 1 } }
          }
        }
      }
    }
  ]
}
