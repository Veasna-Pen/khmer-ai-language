{
  "name": "khmer-ai-language",
  "version": "0.1.0",
  "description": "Open-source Khmer language reference for AI and LLMs",
  "type": "commonjs",
  "scripts": {
    "test": "node tools/validator/validate.js",
    "build": "node tools/compiler/build-dist.js",
    "export": "node tools/export/export-formats.js",
    "evaluate": "node evaluation/evaluate.js",
    "check": "npm test && npm run build && npm run export && npm run evaluate",
    "mcp": "node examples/mcp/server.js",
    "demo:rag": "node examples/rag/simple-khmer-rag.js"
  },
  "keywords": [
    "khmer",
    "ai",
    "llm",
    "translation",
    "localization",
    "natural-language-processing",
    "nlp",
    "terminology",
    "cambodia"
  ],
  "author": "Khmer AI Language Reference Contributors",
  "license": "CC-BY-4.0 AND MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veasna-Pen/khmer-ai-language.git"
  },
  "engines": {
    "node": ">=18"
  }
}
